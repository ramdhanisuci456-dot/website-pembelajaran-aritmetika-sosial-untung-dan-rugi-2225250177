# Salin file ini menjadi .env lalu isi.
# Lokal: biarkan DATABASE_URL kosong -> otomatis pakai SQLite (alpro.db).
# Supabase: isi dengan connection string Postgres dari Supabase
#   (Project Settings > Database > Connection string, pilih "Session pooler").
DATABASE_URL=
SECRET_KEY=ganti-dengan-teks-acak-panjang
# Opsional: batasi kode siswa yang boleh masuk (pisahkan koma). Kosong = siapa pun dengan kode valid.
ALLOWED_CODES=
# Alamat frontend yang boleh memanggil API (pisahkan koma). * = semua.
CORS_ORIGINS=*
